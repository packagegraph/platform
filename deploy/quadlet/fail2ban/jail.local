[DEFAULT]
# Native fail2ban (EPEL: fail2ban, fail2ban-systemd, fail2ban-selinux),
# NOT containerized -- see README.md's "Traffic filtering and abuse
# detection" section for why. journald backend works correctly here
# because fail2ban-systemd provides the real python3-systemd binding.
backend = systemd
banaction = nftables-shared-set

# This is the ACTUAL whitelist -- it prevents a ban from being issued in
# the first place. nftables.conf's trusted_ips set does NOT do this: it
# sits below the banned_ips check in the input chain (an explicit ban
# still wins), it has no visibility into nginx's own request-rate
# limiting (application-layer, inside the proxy, invisible to nftables),
# and it only ever existed to bypass the coarse connection-rate
# pre-filter, not to make a source un-bannable. Loopback is always safe
# to exempt; sync-trusted-source.sh additionally keeps a dynamic-DNS
# admin source in sync here (via `fail2ban-client set <jail>
# addignoreip`) for the same staleness reason trusted_ips needs syncing.
#
# Honest tradeoff: an ignoreip'd source can never be banned by ANY jail,
# so genuine abuse from that exact address goes uncaught. Acceptable for
# a known, narrowly-scoped admin source; do not add broad ranges here.
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = true
# fail2ban's stock sshd filter's prefregex is intentionally generic about
# the process-name token, so it matches this host's split
# sshd-session[PID]: log lines without a custom filter -- verified live.
journalmatch = _SYSTEMD_UNIT=sshd.service
maxretry = 5
findtime = 10m
bantime = 1h

[sparql-proxy-abuse]
enabled = true
filter = sparql-proxy-abuse
# sparql-proxy.container logs to stdout, captured by podman's default
# journald log driver under this unit -- verified live via
# `journalctl -u sparql-proxy.service`.
journalmatch = _SYSTEMD_UNIT=sparql-proxy.service
maxretry = 20
findtime = 1m
bantime = 1h
