# Schedules pg-enrich@npm-provenance.service (deploy/quadlet/enrichers/pg-enrich@.container,
# instantiated with %i=npm-provenance, script: scripts/enrichers/npm-provenance.sh).
# Plain systemd timer, not a quadlet unit -- Podman Quadlet has no .timer
# generator (see qlever-rebuild-index.timer's comment) -- installed as-is
# under /etc/systemd/system/.

# Cadence: matches the Kubernetes original's weekly cadence, timed after the npm collector.
[Unit]
Description=Schedule for pg-enrich@npm-provenance.service

[Timer]
OnCalendar=Mon *-*-* 10:00:00
RandomizedDelaySec=120
Persistent=true
Unit=pg-enrich@npm-provenance.service

[Install]
WantedBy=timers.target
