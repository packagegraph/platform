# Schedules pg-enrich@repology.service (deploy/quadlet/enrichers/pg-enrich@.container,
# instantiated with %i=repology, script: scripts/enrichers/repology.sh).
# Plain systemd timer, not a quadlet unit -- Podman Quadlet has no .timer
# generator (see qlever-rebuild-index.timer's comment) -- installed as-is
# under /etc/systemd/system/.

# Cadence: matches the Kubernetes original's weekly cadence.
[Unit]
Description=Schedule for pg-enrich@repology.service

[Timer]
OnCalendar=Mon *-*-* 11:30:00
RandomizedDelaySec=120
Persistent=true
Unit=pg-enrich@repology.service

[Install]
WantedBy=timers.target
