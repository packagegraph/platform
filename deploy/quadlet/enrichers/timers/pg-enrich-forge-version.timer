# Schedules pg-enrich@forge-version.service (deploy/quadlet/enrichers/pg-enrich@.container,
# instantiated with %i=forge-version, script: scripts/enrichers/forge-version.sh).
# Plain systemd timer, not a quadlet unit -- Podman Quadlet has no .timer
# generator (see qlever-rebuild-index.timer's comment) -- installed as-is
# under /etc/systemd/system/.

# Cadence: forge release-tag scraping is slow-changing; weekly is more than sufficient.
[Unit]
Description=Schedule for pg-enrich@forge-version.service

[Timer]
OnCalendar=Mon *-*-* 13:00:00
RandomizedDelaySec=120
Persistent=true
Unit=pg-enrich@forge-version.service

[Install]
WantedBy=timers.target
