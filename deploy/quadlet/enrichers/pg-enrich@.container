# Templated enrichment unit -- same shape as ../collectors/pg-collect@.container,
# one instance per enricher, scheduled independently by the matching
# timers/pg-enrich-<name>.timer. Ported from deploy/overlays/{dev,prod}/jobs/
# enrich-*.yaml, minus the direct-to-Fuseki drop+load round trip those jobs
# do (no writable Fuseki on this host -- see collectors/pg-collect@.container's
# header for the same reasoning): every enricher here just enriches and
# uploads a .nt/.graph pair to Minio's nt-output/ prefix, picked up by
# qlever-rebuild-index.timer on its own nightly schedule.
#
# %i is the enricher name (matches the .sh filename under scripts/enrichers/).
#
# Discovery queries (what needs enriching) go against the local QLever
# instance the same way collectors' discovery-mode queries do -- see that
# file's comment for why FUSEKI_ENDPOINT/SPARQL_BACKEND/QLEVER_ACCESS_TOKEN
# are set the way they are.

[Unit]
Description=PackageGraph enricher: %i
After=network-online.target
Wants=network-online.target

[Container]
# devel-latest, not latest -- see collectors/pg-collect@.container and
# "Image tags and auto-update" in ../README.md.
Image=ghcr.io/packagegraph/etl:devel-latest
AutoUpdate=registry
Network=host
EnvironmentFile=/etc/containers/systemd/scripts/minio.env
EnvironmentFile=/etc/containers/systemd/scripts/qlever.env
Environment=HOME=/tmp
Environment=SPARQL_BACKEND=qlever
Environment=FUSEKI_ENDPOINT=http://127.0.0.1:7001
Volume=/etc/containers/systemd/scripts/enrichers/%i.sh:/usr/local/bin/enrich.sh:ro
Entrypoint=/bin/sh
Exec=/usr/local/bin/enrich.sh
NoNewPrivileges=true
DropCapability=ALL
# Raised 4g -> 8g on 2026-09-15 after pg-enrich@taxonomy was OOM-killed at the
# 4g cap on 2026-09-14 (exit 137, "killed by the OOM killer", 4.0G peak reached
# in 29 seconds).
#
# Stated honestly: the OOM does not reproduce. Re-running enrich-taxonomy on
# 2026-09-15 under a deliberately generous 24g cap, purely to measure, it
# succeeded in 72s with a peak of 2.55 GiB -- comfortably inside the old 4g.
# The index was rebuilt between the two runs and fedora-44 was republished, so
# the 09-14 input was not the 09-15 input, and the exact trigger is unexplained.
#
# The raise is still justified on headroom rather than on the incident:
#   - measured peak 2.55 GiB against a 4g cap is only ~1.4 GiB of margin;
#   - the run also writes a 328 MB .nt, and cgroup v2 charges that page cache
#     to the same limit, so the effective margin is smaller than it looks;
#   - the work scales with the corpus -- 2,905,982 package identities today,
#     growing with every collection -- so the margin shrinks on its own.
#
# Safe to apply to the shared template: Memory= is a cap, not a reservation,
# and the other enrichers are nowhere near it (koji peaked at 677 MB, security
# at 292 MB on their last runs), so they are unaffected.
Memory=8g
PodmanArgs=--cpus=2

[Service]
Type=oneshot
RemainAfterExit=no
# Raised 2h -> 8h 2026-09-10: koji and security both got SIGKILL'd at the
# old 2h ceiling mid-run (koji ~19,700 packages in, security ~11,400 in,
# both still steadily progressing, not hung) -- shared across all
# enrichers, but only matters for the slow ones since fast ones just
# finish early regardless. Does NOT fix repology: at its observed rate
# (~100 pkgs / 1.7min against 314,416 total) it needs ~90h, far beyond any
# reasonable timeout here -- see repology.sh's cache-sync comment.
TimeoutStartSec=28800
