# Shared between sparql-proxy.container (writes) and fail2ban.container's
# sparql-proxy-abuse jail (reads, read-only mount) -- file-based logging
# alongside stdout specifically because fail2ban's crazymax/fail2ban image
# lacks the systemd/journald backend (see fail2ban/jail.local).
#
# Backed by the dedicated data disk mounted at /var/lib/packagegraph (see
# deploy/quadlet/README.md's "Dedicated data disk" section). If your host
# has no such disk, delete the Device=/Type=/Options= lines to fall back
# to normal Podman storage.

[Volume]
VolumeName=sparql-proxy-logs
Device=/var/lib/packagegraph/sparql-proxy-logs
Type=none
Options=bind

[Install]
WantedBy=default.target
