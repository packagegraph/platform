# PackageGraph QLever SPARQL endpoint. Equivalent of the qlever Deployment +
# Service in deploy/base/qlever/{deployment,service}.yaml.
#
# PublishPort binds to loopback only by default -- unlike the Kubernetes
# Service (ClusterIP, reachable externally only through the TLS+basic-auth
# sparql-proxy in deploy/base/sparql-proxy/), a bare `7001:7001` here would
# bind all host interfaces with only the QLever access token for protection.
# Put a TLS+auth reverse proxy in front (see deploy/base/sparql-proxy/configmap.yaml
# for a model) before changing this to anything wider than 127.0.0.1.

[Unit]
Description=PackageGraph QLever SPARQL endpoint
Requires=qlever-index-load.service
After=qlever-index-load.service

[Container]
ContainerName=qlever
Image=docker.io/adfreiburg/qlever:commit-1075455fae
# Must match qlever-index-load.container's User= -- see its comment. Pinned
# to the "qlever" user's own UID (999) inside this image, rather than the
# other way around, since this is the container that actually serves reads
# against /data and writes qlever-server's own per-query metrics/resource
# logs there.
User=999
Volume=qlever-data.volume:/data:Z
EnvironmentFile=/etc/containers/systemd/scripts/qlever.env
PublishPort=127.0.0.1:7001:7001
# SECURITY NOTE: this pinned qlever-server binary only accepts its admin token
# via the -a/--access-token argv flag -- no env-var or token-file option
# exists in this image (the Qleverfile ACCESS_TOKEN setting is consumed by the
# Python `qlever` wrapper, which is not run here; cf. qlever-control#259). The
# token is sourced from qlever.env (EnvironmentFile above), but argv expansion
# re-exposes it in this container's own process table (/proc/<pid>/cmdline).
# Accepted and bounded: reading it requires a shell inside this container or
# host root, both already-privileged. Mirrors the identical tradeoff in
# deploy/base/qlever/deployment.yaml.
# The image's own ENTRYPOINT (/qlever/docker-entrypoint.sh) expects one of its
# own recognized invocation forms (interactive, `-c "qlever ..."`, etc.) and
# just prints a usage banner and exits for anything else -- Exec= alone only
# appends args to that entrypoint, it doesn't replace it (unlike Kubernetes'
# `command:`, which does). Override it with Entrypoint= instead, matching
# deploy/base/qlever/deployment.yaml's `command: ["/qlever/qlever-server"]`.
Entrypoint=/bin/sh
# Resource sizing, measured on this host (46G RAM, 12 Neoverse-N1 cores, 3.0G
# index). The previous settings (-m 4G -c 1G -e 500M, Memory=6g, --cpus=4)
# were binding on both axes: systemd logged a "6G memory peak" against the 6g
# ceiling, and an ordinary corpus-wide aggregate over one class failed with
# "Tried to allocate 250 kB, but only 114.5 kB were available". Analytical
# queries over ~200M triples are a normal workload for this endpoint.
#
#   -m 24G  query-processing budget (was 4G). QLever enforces this itself by
#           refusing allocations, so it self-limits well below the cgroup
#           ceiling -- the ceiling is a backstop, not the operative limit.
#   -c 4G   result cache (was 1G), -e 2G per-entry ceiling (was 500M). Raising
#           -e matters independently: a large aggregate whose result exceeded
#           500M was not cacheable at all, so every repeat paid full cost.
#   -j 8    worker threads (was 4), and --cpus=8 to match. Memory only lets a
#           big query *finish*; thread count is what changes its wall-clock.
#           4 of 12 cores while the server idles ~0.5% under query load was
#           leaving two thirds of the box unused. Matches the --cpus=8 the
#           rebuild unit already uses; the two contend only at 03:30, when
#           query load is nil.
#   Memory=32g cgroup ceiling, covering -m + -c + the 3G index's page cache
#           plus process overhead. Index pages are file-backed and
#           reclaimable, so a generous ceiling keeps more of it resident.
#
# Headroom: collector/enricher units cap at 4g each and run ~1.2G in practice;
# observed whole-host usage was 6G of 46G. These are ceilings, not
# reservations, so 32g here does not deny the collectors anything.
Exec=-c "exec /qlever/qlever-server -i /data/index/packagegraph -j 8 -p 7001 -m 24G -c 4G -e 2G -k 200 -s 300s -a \"$QLEVER_ACCESS_TOKEN\""
Memory=32g
PodmanArgs=--cpus=8
NoNewPrivileges=true
DropCapability=ALL
# The k8s readinessProbe issues a real SPARQL query via kubelet's own httpGet
# (no in-container binary needed). Podman's HealthCmd execs inside the
# container instead, and curl/wget presence in the upstream QLever image is
# unverified, so this checks port 7001 is listening via /proc/net/tcp (0x1B59
# = 7001) rather than assuming a specific HTTP client exists. Swap in a
# curl-based query check if you confirm one is present.
HealthCmd=/bin/sh -c 'grep -q ":1B59 " /proc/net/tcp || grep -q ":1B59 " /proc/net/tcp6'
HealthInterval=30s
HealthStartPeriod=15s
HealthRetries=5

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
