# Dedicated template for the two RHEL collectors (rhel-9-full, rhel-10-full)
# only -- split out from pg-collect@.container on 2026-09-11 after the
# shared template's first real production run of rhel-9-full/rhel-10-full
# failed: `Volume=...:ro` bind mounts of /etc/pki/entitlement and
# /etc/rhsm/ca hit SELinux denials inside the container (those paths carry
# cert_t/rhsmcertd_config_t, not a type container processes are allowed to
# read), and Quadlet's plain Volume= doesn't auto-relabel. The fix here is
# `--security-opt label=disable`, scoped to only these two collectors
# rather than the shared template every other collector uses -- relabeling
# the real host files instead (:z/:Z) was ruled out because that would
# permanently change their SELinux context and could break rhsmcertd's own
# access to its own certs.
#
# Otherwise identical to pg-collect@.container -- see that file's header
# comment for the shared design rationale (Network=host, FUSEKI_ENDPOINT
# naming, timeout sizing, etc.). Keep the two in sync for anything that
# isn't RHEL-specific.

[Unit]
Description=PackageGraph collector: %i
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/packagegraph/etl:devel-latest
AutoUpdate=registry
Network=host
EnvironmentFile=/etc/containers/systemd/scripts/minio.env
EnvironmentFile=/etc/containers/systemd/scripts/qlever.env
Environment=HOME=/tmp
Environment=SPARQL_BACKEND=qlever
Environment=FUSEKI_ENDPOINT=http://127.0.0.1:7001
# Scratch space (cache + pre-upload output) on the dedicated data disk,
# not the container's overlay writable layer -- see
# pg-collect-scratch.volume's comment. Shared with pg-collect@.container's
# instances; safe because each script namespaces its own paths under
# /tmp/cache/<name> and /tmp/collection/<name>.nt. :z (lowercase, shared
# label), not :Z -- see pg-collect-scratch.volume's comment for the
# EACCES incident :Z caused here.
Volume=pg-collect-scratch.volume:/tmp:z
Volume=/etc/containers/systemd/scripts/collectors/%i.sh:/usr/local/bin/collect.sh:ro
# RHEL entitlement cert/key + Red Hat CA (TLS client-cert auth -- see
# rhel-9-full.sh/rhel-10-full.sh and docs/rhel-collection.md).
Volume=/etc/pki/entitlement:/etc/pki/entitlement:ro
Volume=/etc/rhsm/ca:/etc/rhsm/ca:ro
PodmanArgs=--security-opt label=disable
Entrypoint=/bin/sh
Exec=/usr/local/bin/collect.sh
NoNewPrivileges=true
DropCapability=ALL
# Raised from the shared template's 4g: the first real run OOM-killed at
# 4g decompressing/parsing BaseOS's ~137MB primary.xml.gz for a second
# arch (aarch64) with --with-spec --with-maintainers both enabled --
# confirmed live 2026-09-11. Safe to raise independently of the shared
# pg-collect@.container's limit now that these two collectors have their
# own template; host has 37Gi free at the time of writing.
Memory=12g
PodmanArgs=--cpus=2

[Service]
Type=oneshot
RemainAfterExit=no
TimeoutStartSec=28800
