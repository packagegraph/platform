# Schedules pg-collect@centos-stream-10-full.service (deploy/quadlet/collectors/pg-collect@.container,
# instantiated with %i=centos-stream-10-full, script: scripts/collectors/centos-stream-10-full.sh).
# Plain systemd timer, not a quadlet unit -- Podman Quadlet has no .timer
# generator (see qlever-rebuild-index.timer's comment) -- installed as-is
# under /etc/systemd/system/.

[Unit]
Description=Schedule for pg-collect@centos-stream-10-full.service

# Cadence: CentOS Stream is a rolling preview of RHEL -- faster-moving than a stable point release, slower than Fedora rawhide.
[Timer]
OnCalendar=Tue,Thu,Sat *-*-* 03:00:00
RandomizedDelaySec=120
Persistent=true
Unit=pg-collect@centos-stream-10-full.service

[Install]
WantedBy=timers.target
