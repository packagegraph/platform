# Schedules pg-collect@ubuntu-noble-arm64.service (deploy/quadlet/collectors/pg-collect@.container,
# instantiated with %i=ubuntu-noble-arm64, script: scripts/collectors/ubuntu-noble-arm64.sh).
# Plain systemd timer, not a quadlet unit -- Podman Quadlet has no .timer
# generator (see qlever-rebuild-index.timer's comment) -- installed as-is
# under /etc/systemd/system/.

[Unit]
Description=Schedule for pg-collect@ubuntu-noble-arm64.service

[Timer]
OnCalendar=Mon *-*-* 08:30:00
RandomizedDelaySec=120
Persistent=true
Unit=pg-collect@ubuntu-noble-arm64.service

[Install]
WantedBy=timers.target
