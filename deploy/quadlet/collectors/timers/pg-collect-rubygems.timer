# Schedules pg-collect@rubygems.service (deploy/quadlet/collectors/pg-collect@.container,
# instantiated with %i=rubygems, script: scripts/collectors/rubygems.sh).
# Plain systemd timer, not a quadlet unit -- Podman Quadlet has no .timer
# generator (see qlever-rebuild-index.timer's comment) -- installed as-is
# under /etc/systemd/system/.

[Unit]
Description=Schedule for pg-collect@rubygems.service

# Cadence: RubyGems has a high daily publish volume.
[Timer]
OnCalendar=*-*-* 12:00:00
RandomizedDelaySec=120
Persistent=true
Unit=pg-collect@rubygems.service

[Install]
WantedBy=timers.target
