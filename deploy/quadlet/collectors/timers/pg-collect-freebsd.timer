# Schedules pg-collect@freebsd.service (deploy/quadlet/collectors/pg-collect@.container,
# instantiated with %i=freebsd, script: scripts/collectors/freebsd.sh).
# Plain systemd timer, not a quadlet unit -- Podman Quadlet has no .timer
# generator (see qlever-rebuild-index.timer's comment) -- installed as-is
# under /etc/systemd/system/.

[Unit]
Description=Schedule for pg-collect@freebsd.service

[Timer]
OnCalendar=Mon *-*-* 10:00:00
RandomizedDelaySec=120
Persistent=true
Unit=pg-collect@freebsd.service

[Install]
WantedBy=timers.target
