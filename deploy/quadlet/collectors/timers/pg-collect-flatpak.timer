# Schedules pg-collect@flatpak.service (deploy/quadlet/collectors/pg-collect@.container,
# instantiated with %i=flatpak, script: scripts/collectors/flatpak.sh).
# Plain systemd timer, not a quadlet unit -- Podman Quadlet has no .timer
# generator (see qlever-rebuild-index.timer's comment) -- installed as-is
# under /etc/systemd/system/.

[Unit]
Description=Schedule for pg-collect@flatpak.service

[Timer]
OnCalendar=Mon *-*-* 11:00:00
RandomizedDelaySec=120
Persistent=true
Unit=pg-collect@flatpak.service

[Install]
WantedBy=timers.target
