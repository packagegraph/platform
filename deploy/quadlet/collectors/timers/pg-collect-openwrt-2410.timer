# Schedules pg-collect@openwrt-2410.service (deploy/quadlet/collectors/pg-collect@.container,
# instantiated with %i=openwrt-2410, script: scripts/collectors/openwrt-2410.sh).
# Plain systemd timer, not a quadlet unit -- Podman Quadlet has no .timer
# generator (see qlever-rebuild-index.timer's comment) -- installed as-is
# under /etc/systemd/system/.

[Unit]
Description=Schedule for pg-collect@openwrt-2410.service

[Timer]
OnCalendar=Wed *-*-* 06:00:00
RandomizedDelaySec=120
Persistent=true
Unit=pg-collect@openwrt-2410.service

[Install]
WantedBy=timers.target
