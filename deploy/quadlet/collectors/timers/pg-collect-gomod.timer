# Schedules pg-collect@gomod.service (deploy/quadlet/collectors/pg-collect@.container,
# instantiated with %i=gomod, script: scripts/collectors/gomod.sh).
# Plain systemd timer, not a quadlet unit -- Podman Quadlet has no .timer
# generator (see qlever-rebuild-index.timer's comment) -- installed as-is
# under /etc/systemd/system/.

[Unit]
Description=Schedule for pg-collect@gomod.service

# Cadence: Go module proxy discovery churns faster than weekly but well below npm/pypi volume.
[Timer]
OnCalendar=Mon,Wed,Fri *-*-* 08:00:00
RandomizedDelaySec=120
Persistent=true
Unit=pg-collect@gomod.service

[Install]
WantedBy=timers.target
