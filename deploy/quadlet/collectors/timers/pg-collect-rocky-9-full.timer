# Schedules pg-collect@rocky-9-full.service (deploy/quadlet/collectors/pg-collect@.container,
# instantiated with %i=rocky-9-full, script: scripts/collectors/rocky-9-full.sh).
# Plain systemd timer, not a quadlet unit -- Podman Quadlet has no .timer
# generator (see qlever-rebuild-index.timer's comment) -- installed as-is
# under /etc/systemd/system/.

[Unit]
Description=Schedule for pg-collect@rocky-9-full.service

# Cadence: stable RHEL rebuild, weekly is plenty. Staggered off debian-trixie-full's Sat 02:00 slot.
[Timer]
OnCalendar=Wed *-*-* 04:00:00
RandomizedDelaySec=120
Persistent=true
Unit=pg-collect@rocky-9-full.service

[Install]
WantedBy=timers.target
