# Templated collector unit -- one instance per package ecosystem/distro,
# scheduled independently by the matching timers/pg-collect-<name>.timer.
# Equivalent of the collect-<name> CronJobs in
# deploy/overlays/{dev,prod}/jobs/collect-*.yaml, minus the direct-to-Fuseki
# load step: this host has no writable Fuseki (only QLever, which is
# read-only -- see sparql-proxy.container's comment), so every collector
# here only collects and uploads .nt/.graph pairs to Minio's nt-output/
# prefix. qlever-rebuild-index.timer picks those up on its own nightly
# schedule and promotes them into the live QLever index -- see
# [[qlever-tdb2-decoupling]] in the README's cross-reference, or just
# qlever-rebuild-index.sh directly.
#
# %i is the collector name (matches the .sh filename under scripts/collectors/
# and the GRAPH_URI/logic baked into that script -- this unit file has no
# per-collector knowledge at all, it only runs whatever script %i names).
#
# SPARQL_BACKEND=qlever + FUSEKI_ENDPOINT pointed at the loopback QLever
# instance (below) lets discovery-mode collectors (npm, pypi, maven, ...)
# query already-collected data without a Fuseki instance: pg-collect's
# discovery queries are plain SPARQL 1.1 SELECT, confirmed QLever-compatible.
# The env var is still named FUSEKI_ENDPOINT (not renamed to SPARQL_ENDPOINT)
# so the collector scripts below stay copy-paste identical to the
# Kubernetes jobs they were ported from.
#
# Network=host is required to reach qlever.container's PublishPort
# (127.0.0.1:7001, loopback-only by design -- see qlever.container's
# comment) from inside this container; Podman's default bridge/pasta
# networking has its own loopback and can't see the host's.

[Unit]
Description=PackageGraph collector: %i
After=network-online.target
Wants=network-online.target

[Container]
# devel-latest, not latest: it floats on every merge to main, which is what
# this host should track until a v* release is cut. See
# "Image tags and auto-update" in ../README.md.
Image=ghcr.io/packagegraph/etl:devel-latest
AutoUpdate=registry
Network=host
EnvironmentFile=/etc/containers/systemd/scripts/minio.env
EnvironmentFile=/etc/containers/systemd/scripts/qlever.env
Environment=HOME=/tmp
Environment=SPARQL_BACKEND=qlever
Environment=FUSEKI_ENDPOINT=http://127.0.0.1:7001
# Scratch space (cache + pre-upload output) on the dedicated data disk,
# not the container's overlay writable layer -- see
# pg-collect-scratch.volume's comment. Shared by every concurrently
# running collector instance; safe because each script namespaces its own
# paths under /tmp/cache/<name> and /tmp/collection/<name>.nt. :z
# (lowercase, shared label), not :Z -- see pg-collect-scratch.volume's
# comment for the EACCES incident :Z caused here.
Volume=pg-collect-scratch.volume:/tmp:z
Volume=/etc/containers/systemd/scripts/collectors/%i.sh:/usr/local/bin/collect.sh:ro
# Curated seed lists (currently maven-roots.txt), installed from
# deploy/quadlet/collectors/seeds/. Mounted rather than baked into the image so
# editing a data file does not require a coordinated image cutover.
#
# WARNING: this directory must exist on the host. Podman does not create a
# missing bind-mount source -- it fails with `statfs ...: no such file or
# directory` -- and because this template is shared by every collector, a
# missing /etc/containers/systemd/seeds breaks all of them, not just the ones
# that read a seed list. checkpoint-release.py stages and verifies its contents
# alongside the wrappers; keep them installed together.
#
# :ro with no :z, matching the wrapper mount above: the host directory is
# etc_t, which containers on this host can already read, so relabelling /etc
# content is unnecessary. (Contrast pg-collect-scratch above, which needs :z.)
Volume=/etc/containers/systemd/seeds:/seeds:ro
Entrypoint=/bin/sh
Exec=/usr/local/bin/collect.sh
NoNewPrivileges=true
DropCapability=ALL
Memory=4g
PodmanArgs=--cpus=2

[Service]
Type=oneshot
RemainAfterExit=no
# Ceiling generous enough for the slowest job (fedora-43-full's Koji+spec
# enrichment pass) rather than tuned per collector -- one shared template
# file, one shared timeout. Raised from 5h to 8h on 2026-09-10 after
# fedora-43-full hit the 5h ceiling at 99.6% complete (23,900/23,999 spec
# files) and lost the entire run -- a oneshot service with no incremental
# upload (upload-nt.sh only runs after full completion) means a timeout
# discards everything, not just the tail. Compounding cause found and
# fixed the same day: cache.rs's Minio-backed Koji cache was silently
# failing 100% of its reads/writes (wrong auth scheme for Scaleway's S3
# API), so every run re-fetched every Koji build from scratch with no
# cross-run caching benefit -- fixed same day in etl/pg-collect/src/cache.rs
# (AWS SigV4 signing instead of HTTP Basic Auth).
#
# Raised again from 8h to 14h on 2026-09-15, this time from a measurement
# rather than an estimate. An instrumented fedora-44-full run (checkpointing
# enabled, so its progress was observable rather than lost) completed the
# RPM and spec stages in ~5h and then enriched Koji at a measured 39 NVRs/min
# over 23,641 NVRs -- ~12h50m in total. 8h killed it at roughly the halfway
# point of the Koji stage, every time.
#
# 14h is a ceiling, not a target: checkpointing means an overrun resumes
# rather than restarting, so the cost of setting this generously is bounded,
# while the cost of setting it short is a collector that can never publish.
#
# It is still one shared timeout for all 43 collectors, sized to the slowest
# -- and rpm-full is not the only one near the old limit: cargo ran 6h47m on
# 2026-09-14. The price is that a genuinely hung fast collector now occupies
# 14h instead of 8h before systemd kills it. Per-stage timeouts are the real
# answer to that and want the pipeline split into separate units with
# triggered hand-offs; see
# docs/superpowers/specs/2026-09-15-collector-stage-decomposition-design.md.
TimeoutStartSec=50400
