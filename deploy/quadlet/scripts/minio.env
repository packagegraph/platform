# Minio credentials shared by qlever-index-load.service, qlever-rebuild-index.service,
# and qlever-refresh-if-changed.sh's own `podman run`.
# Placeholder values — replace before starting any unit, then:
#   chmod 600 minio.env && chown root:root minio.env
# Mirrors deploy/base/minio/secret.yaml's format for the Kubernetes Secret.
MINIO_ENDPOINT=http://minio.packagegraph.svc:9000
MINIO_BUCKET=packagegraph
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
