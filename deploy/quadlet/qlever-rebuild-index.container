# Nightly QLever index rebuild from the .nt/.graph corpus in Minio. Equivalent
# of the rebuild-qlever-index CronJob in
# deploy/overlays/{dev,prod}/jobs/rebuild-qlever-index.yaml. Scheduled by
# qlever-rebuild-index.timer.
#
# qlever-refresh-if-changed.sh (ExecStopPost below) then reloads
# qlever-index-load.service and bounces qlever.service if -- and only if --
# the promoted index differs from the one confirmed serving. It decides from
# that comparison, not from this run's exit status or its last-run.json, so a
# run that promotes and then dies before reporting still gets reloaded (#73).
# See that script's header for what it does NOT do (no automatic rollback on
# a failed reload).

[Unit]
Description=PackageGraph QLever nightly index rebuild
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=qlever-rebuild-index
# devel-latest, not latest -- see qlever-index-load.container and
# "Image tags and auto-update" in README.md.
Image=ghcr.io/packagegraph/qlever-rebuild:devel-latest
AutoUpdate=registry
Volume=qlever-rebuild-scratch.volume:/tmp:Z
Volume=/etc/containers/systemd/scripts/qlever-rebuild-index.sh:/usr/local/bin/qlever-rebuild-index.sh:ro
EnvironmentFile=/etc/containers/systemd/scripts/minio.env
Exec=/usr/local/bin/qlever-rebuild-index.sh
Memory=8g
# 8 of the host's 12 cores (Neoverse-N1) -- qlever.service itself idles
# around 0.5% CPU under normal query load, so this leaves comfortable
# headroom for it plus whatever collectors happen to be running
# concurrently. Measured: the previous --cpus=4 limit was ~73% saturated
# (2.9 of 4 cores) during the index-build phase with RAM barely touched
# (81MB of an 8g limit) -- CPU-bound, not memory-bound, so raising the CPU
# ceiling is the lever that should actually shrink wall-clock time.
PodmanArgs=--cpus=8
NoNewPrivileges=true
DropCapability=ALL

[Service]
Type=oneshot
RemainAfterExit=no
TimeoutStartSec=7200
# ExecStopPost=, not ExecStartPost=. systemd runs ExecStartPost= only after
# ExecStart= has succeeded, and the case that most needs a reload is a run
# that PROMOTED and then failed -- the rebuild script exits 1 if it cannot
# persist last-success.json, after `latest` already moved. With
# ExecStartPost= the refresh never fired there, so a correctly promoted index
# sat unloaded until some later run happened to succeed (#73). ExecStopPost=
# runs on both the success and the failure path, and the script is a no-op
# when the promoted index is already the one confirmed serving, so running it
# unconditionally costs one cheap comparison.
#
# A failing ExecStopPost= still marks the unit failed, so a reload problem
# stays visible in `systemctl status` exactly as before.
ExecStopPost=/etc/containers/systemd/scripts/qlever-refresh-if-changed.sh
# The refresh polls readiness for up to 30 x 10s after restarting qlever, and
# ExecStopPost= is bounded by TimeoutStopSec= (default 90s), which would kill
# it mid-poll and leave the serving marker unadvanced on a reload that was
# actually working.
TimeoutStopSec=900

[Install]
WantedBy=default.target
