FROM docker.io/stain/jena-fuseki:5.3.0

USER root

# Install mc (Minio client) and extract Fuseki web UI
ARG JENA_VERSION=5.3.0
RUN apk add --no-cache curl unzip \
    && curl -fsSL https://dl.min.io/client/mc/release/linux-amd64/mc -o /usr/local/bin/mc \
    && chmod +x /usr/local/bin/mc \
    && curl -fsSL "https://repo1.maven.org/maven2/org/apache/jena/jena-fuseki-war/${JENA_VERSION}/jena-fuseki-war-${JENA_VERSION}.war" -o /tmp/fuseki.war \
    && mkdir -p /fuseki/webapp \
    && unzip -qo /tmp/fuseki.war -d /fuseki/webapp -x 'WEB-INF/lib/*' 'WEB-INF/classes/*' 'META-INF/*' 'DEPENDENCIES' \
    && rm /tmp/fuseki.war \
    && chown -R fuseki:fuseki /fuseki/webapp \
    && apk del curl unzip

# Copy config and entrypoint
COPY config.ttl /fuseki/config.ttl
COPY entrypoint.sh /fuseki/entrypoint.sh
COPY catalog.html /fuseki/webapp/catalog.html
RUN chmod +x /fuseki/entrypoint.sh

# TDB2 data volume (populated by init container or entrypoint)
VOLUME /data/tdb2

EXPOSE 3030

ENTRYPOINT ["/fuseki/entrypoint.sh"]
