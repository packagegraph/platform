# Stage 1: Rust builder
FROM docker.io/rust:1.88-slim AS rust-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pg-collect/ .
RUN cargo build --release

# Stage 2: Runtime
FROM docker.io/debian:bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl jq \
    default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

# Install Apache Jena CLI tools (for tdb2.tdbloader)
ARG JENA_VERSION=5.3.0
RUN curl -fsSL https://archive.apache.org/dist/jena/binaries/apache-jena-${JENA_VERSION}.tar.gz \
    | tar -xz -C /opt \
    && mv /opt/apache-jena-${JENA_VERSION} /opt/jena
ENV JENA_HOME=/opt/jena
ENV PATH="${JENA_HOME}/bin:${PATH}"

# Install mc (Minio client) and kubectl (for rollout restart)
RUN curl -fsSL https://dl.min.io/client/mc/release/linux-amd64/mc -o /usr/local/bin/mc \
    && chmod +x /usr/local/bin/mc \
    && curl -fsSL "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl

# Copy pg-collect binary from Rust builder
COPY --from=rust-builder /app/target/release/pg-collect /usr/local/bin/pg-collect


WORKDIR /app

# Copy ontology files (added at build time from ontology repo via sync-ontology.sh)
COPY ontology/ /app/ontology/

COPY entrypoint.sh /app/
RUN chmod +x /app/entrypoint.sh

# Copy helper scripts
COPY scripts/ /app/scripts/
RUN chmod +x /app/scripts/*.sh

ENTRYPOINT ["/app/entrypoint.sh"]
