# Stage 1: Rust builder with cargo-chef for dependency caching
FROM docker.io/rust:1.88-slim AS rust-chef
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN cargo install cargo-chef
WORKDIR /app

FROM rust-chef AS rust-planner
COPY pg-collect/ .
RUN cargo chef prepare --recipe-path recipe.json

FROM rust-chef AS rust-builder
COPY --from=rust-planner /app/recipe.json recipe.json
# Build dependencies - this layer is cached
RUN cargo chef cook --release --recipe-path recipe.json

# Copy source and build application
COPY pg-collect/ .
RUN cargo build --release

# Stage 2: Python application with Rust binary
FROM docker.io/python:3.12-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

# Install Apache Jena CLI tools
ARG JENA_VERSION=5.3.0
RUN curl -fsSL https://archive.apache.org/dist/jena/binaries/apache-jena-${JENA_VERSION}.tar.gz \
    | tar -xz -C /opt \
    && mv /opt/apache-jena-${JENA_VERSION} /opt/jena
ENV JENA_HOME=/opt/jena
ENV PATH="${JENA_HOME}/bin:${PATH}"

# Install mc (Minio client)
RUN curl -fsSL https://dl.min.io/client/mc/release/linux-amd64/mc -o /usr/local/bin/mc \
    && chmod +x /usr/local/bin/mc

# Copy pg-collect binary from Rust builder
COPY --from=rust-builder /app/target/release/pg-collect /usr/local/bin/pg-collect

# Install uv for fast dependency resolution
COPY --from=ghcr.io/astral-sh/uv:0.7 /uv /usr/local/bin/uv

WORKDIR /app

# Install Python dependencies
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

ENV PATH="/app/.venv/bin:${PATH}"

# Copy application code and install the project
COPY packagegraph/ packagegraph/
RUN uv pip install --no-deps .

# Copy ontology files (added at build time from ontology repo)
COPY ontology/ /app/ontology/

COPY entrypoint.sh /app/
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
