# Stage 1: Rust builder
FROM docker.io/rust:1.88-slim AS rust-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pg-collect/ .
RUN cargo build --release

# Stage 2: Runtime
FROM docker.io/debian:bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl jq \
    default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

# Install Apache Jena CLI tools (for tdb2.tdbloader)
ARG JENA_VERSION=5.3.0
RUN curl -fsSL https://archive.apache.org/dist/jena/binaries/apache-jena-${JENA_VERSION}.tar.gz \
    | tar -xz -C /opt \
    && mv /opt/apache-jena-${JENA_VERSION} /opt/jena
ENV JENA_HOME=/opt/jena
ENV PATH="${JENA_HOME}/bin:${PATH}"

# Install mc (Minio client) and kubectl (for rollout restart)
# Multi-arch: TARGETARCH is populated automatically by podman/buildah and
# Docker buildx to the arch being built for ("amd64"/"arm64"), matching
# both Minio's GitHub release asset naming (mc.linux-$TARGETARCH) and
# Kubernetes' own release path segment directly.
#
# mc is pinned and downloaded from GitHub Releases rather than dl.min.io --
# confirmed live 2026-09-11: MinIO has retired dl.min.io's raw binary
# distribution entirely (both pinned-version and unversioned "latest" URLs
# return HTTP 410 Gone now), and the minio/mc Docker Hub image now requires
# authentication even for anonymous pulls. See
# etl/Containerfile.qlever-rebuild for the identical fix and full
# rationale. This also pins a version for the first time -- this file
# previously downloaded whatever "latest" happened to be.
ARG TARGETARCH
ARG MC_VERSION=RELEASE.2025-04-08T15-39-49Z
RUN curl -fsSL "https://github.com/minio/mc/releases/download/${MC_VERSION}/mc.linux-${TARGETARCH}.${MC_VERSION}" -o /usr/local/bin/mc \
    && curl -fsSL "https://github.com/minio/mc/releases/download/${MC_VERSION}/mc.linux-${TARGETARCH}.${MC_VERSION}.sha256sum" -o /tmp/mc.sha256sum \
    && echo "$(awk '{print $1}' /tmp/mc.sha256sum)  /usr/local/bin/mc" | sha256sum -c - \
    && chmod +x /usr/local/bin/mc \
    && rm /tmp/mc.sha256sum \
    && curl -fsSL "https://dl.k8s.io/release/$(curl -fsSL https://dl.k8s.io/release/stable.txt)/bin/linux/${TARGETARCH}/kubectl" -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl

# Copy pg-collect binary from Rust builder
COPY --from=rust-builder /app/target/release/pg-collect /usr/local/bin/pg-collect


WORKDIR /app

# Copy ontology files (added at build time from ontology repo via sync-ontology.sh)
COPY ontology/ /app/ontology/

COPY entrypoint.sh /app/
RUN chmod +x /app/entrypoint.sh

# Copy helper scripts
COPY scripts/ /app/scripts/
RUN chmod +x /app/scripts/*.sh

# Seed lists are deliberately NOT copied here. They are collection inputs with
# their own review cadence, and baking them in would make editing a data file
# require a full coordinated image cutover (see
# deploy/quadlet/collectors/checkpoint-cutover.md). They are installed on the
# host from deploy/quadlet/collectors/seeds/ and bind-mounted at /seeds.

ENTRYPOINT ["/app/entrypoint.sh"]
