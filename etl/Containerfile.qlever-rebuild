# QLever index rebuild image — based on QLever with mc, kubectl, and jq added.
# Used by the rebuild-qlever-index CronJob.
#
# Multi-arch: the adfreiburg/qlever base publishes amd64 and arm64, so this
# image does too. TARGETARCH is populated automatically by podman/buildah
# (and Docker buildx) to the arch being built for -- "amd64"/"arm64", which
# matches both the Minio release path segment (linux-$TARGETARCH) and
# Kubernetes' own release path segment (bin/linux/$TARGETARCH) directly, no
# translation needed.
FROM docker.io/adfreiburg/qlever:commit-1075455fae

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl jq \
    && rm -rf /var/lib/apt/lists/*

# Install mc (Minio client) — pinned version with sha256 verification
ARG TARGETARCH
ARG MC_VERSION=RELEASE.2025-04-08T15-39-49Z
RUN curl -fsSL "https://dl.min.io/client/mc/release/linux-${TARGETARCH}/archive/mc.${MC_VERSION}" -o /tmp/mc.${MC_VERSION} \
    && curl -fsSL "https://dl.min.io/client/mc/release/linux-${TARGETARCH}/archive/mc.${MC_VERSION}.sha256sum" -o /tmp/mc.sha256sum \
    && cd /tmp && sha256sum -c mc.sha256sum \
    && mv /tmp/mc.${MC_VERSION} /usr/local/bin/mc \
    && chmod +x /usr/local/bin/mc \
    && rm /tmp/mc.sha256sum

# Install kubectl — pinned version with sha256 verification
ARG KUBECTL_VERSION=v1.31.4
RUN curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" -o /usr/local/bin/kubectl \
    && curl -fsSL "https://dl.k8s.io/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl.sha256" -o /tmp/kubectl.sha256 \
    && echo "$(cat /tmp/kubectl.sha256)  /usr/local/bin/kubectl" | sha256sum -c - \
    && chmod +x /usr/local/bin/kubectl \
    && rm /tmp/kubectl.sha256

# Run as non-root (UID 1000 already exists in the QLever base image)
USER 1000

ENV PATH="/qlever:${PATH}"

ENTRYPOINT ["/bin/bash"]
